  let configureBarTooltipEl = null;

  function ensureConfigureBarTooltip() {
    if (configureBarTooltipEl) return configureBarTooltipEl;
    const P = configureBarPalette();
    configureBarTooltipEl = el('div', {
      position: 'fixed',
      display: 'none',

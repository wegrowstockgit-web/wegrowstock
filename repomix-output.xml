    serial_number VARCHAR(100) NOT NULL,
    status        VARCHAR(30) NOT NULL DEFAULT 'IN_STOCK'
        CHECK (status IN ('IN_STOCK', 'SHIPPED', 'SCRAPPED', 'RMA_RETURNED')),
    created_at    TIMESTAMPTZ NOT NULL DEFAULT NOW(),

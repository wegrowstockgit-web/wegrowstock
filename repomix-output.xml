                <dd className="text-text">{selected.email}</dd>
              </div>
              <div>
                <dt className="text-text-muted">Phone</dt>
                <dd className="text-text">{selected.phone || '—'}</dd>
              </div>
            </dl>
            <Button
              size="lg"
              className="h-14 w-full text-base font-semibold"
              loading={approveMutation.isPending}

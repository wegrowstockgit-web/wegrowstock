<file path="backend/invsys-core/src/main/resources/templates/documents/packing_slip_template.html">
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN"
        "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
    <title th:text="${documentTitle}">Packing Slip</title>
    <style th:replace="~{documents/fragments :: styles}" type="text/css"></style>
</head>
<body>
<div th:replace="~{documents/fragments :: header}"></div>

<table class="meta-table" cellpadding="0" cellspacing="0">
    <tr>
        <td>
            <strong>Ship to</strong><br/>
            <span th:text="${customerName}">Customer</span><br/>
            <span class="muted" th:utext="${customerAddressHtml}">Address</span>
        </td>
        <td>
            <strong>Ship date</strong><br/>
            <span th:text="${shipDate}">2026-07-22</span><br/><br/>
            <strong>Carrier</strong><br/>
            <span th:text="${carrier}">Carrier</span><br/><br/>
            <strong th:if="${trackingNumber}">Tracking</strong><br th:if="${trackingNumber}"/>
            <span th:if="${trackingNumber}" th:text="${trackingNumber}">1Z</span><br th:if="${salesOrderNumber}"/>
            <strong th:if="${salesOrderNumber}">Sales order</strong><br th:if="${salesOrderNumber}"/>
            <span th:if="${salesOrderNumber}" th:text="${salesOrderNumber}">SO-1</span>
        </td>
    </tr>
</table>

<table class="lines">
    <thead>
    <tr>
        <th>SKU / Description</th>
        <th class="right">Qty shipped</th>
    </tr>
    </thead>
    <tbody>
    <tr th:each="line : ${lines}">
        <td th:text="${line.description}">SKU</td>
        <td class="right" th:text="${line.qty}">1</td>
    </tr>
    </tbody>
</table>

<p class="muted" style="margin-top: 16px;">
    Prices intentionally omitted. Verify carton contents against this slip before seal.
</p>

<div th:replace="~{documents/fragments :: footer}"></div>
</body>
</html>
</file>

<file path="backend/invsys-core/src/main/resources/application-prod.yml">
spring:
  config:
    activate:
      on-profile: prod
  datasource:
    # Prefer PgBouncer in front of Postgres (DB_HOST/DB_PORT point at the pooler).
    url: jdbc:postgresql://${DB_HOST:pgbouncer}:${DB_PORT:6432}/${DB_NAME:invsys}?prepareThreshold=0
    hikari:
      maximum-pool-size: ${HIKARI_MAX_POOL_SIZE:15}
      minimum-idle: ${HIKARI_MIN_IDLE:2}
      connection-init-sql: "SELECT set_config('app.current_tenant', '', false)"
  flyway:
    # Prefer a direct Postgres endpoint for migrations when available.
    url: jdbc:postgresql://${FLYWAY_HOST:${DB_HOST:pgbouncer}}:${FLYWAY_PORT:5432}/${DB_NAME:invsys}?prepareThreshold=0

management:
  endpoints:
    web:
      exposure:
        include: health,prometheus
  endpoint:
    health:
      # Public edge blocks /actuator/* except shallow health; details only on private scrape path.
      show-details: when_authorized
      show-components: when_authorized
    prometheus:
      enabled: true
  health:
    db:
      enabled: true

springdoc:
  api-docs:
    enabled: false
  swagger-ui:
    enabled: false

invsys:
  security:
    public-signup-enabled: ${PUBLIC_SIGNUP_ENABLED:false}
  stripe:
    webhook-secret: ${STRIPE_WEBHOOK_SECRET}
    secret-key: ${STRIPE_SECRET_KEY}
    connect-return-url: ${STRIPE_CONNECT_RETURN_URL}
  easypost:
    api-key: ${EASYPOST_API_KEY}
    default-from:
      name: ${EASYPOST_FROM_NAME}
      company: ${EASYPOST_FROM_COMPANY:}
      street1: ${EASYPOST_FROM_STREET1}
      street2: ${EASYPOST_FROM_STREET2:}
      city: ${EASYPOST_FROM_CITY}
      state: ${EASYPOST_FROM_STATE}
      zip: ${EASYPOST_FROM_ZIP}
      country: ${EASYPOST_FROM_COUNTRY:US}
      phone: ${EASYPOST_FROM_PHONE:}
      email: ${EASYPOST_FROM_EMAIL:}
  shopify:
    api-key: ${SHOPIFY_API_KEY}
    api-version: ${SHOPIFY_API_VERSION:2024-10}
  webhooks:
    shopify-secret: ${SHOPIFY_WEBHOOK_SECRET}
    easypost-secret: ${EASYPOST_WEBHOOK_SECRET}
    accounting-secret: ${ACCOUNTING_WEBHOOK_SECRET}
  jwt:
    private-key-pem: ${JWT_PRIVATE_KEY}
    public-key-pem: ${JWT_PUBLIC_KEY}
  integration:
    master-key: ${INTEGRATION_MASTER_KEY}
  frontend-url: ${FRONTEND_URL}
</file>


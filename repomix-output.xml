                .andExpect(status().isOk())
                .andExpect(jsonPath("$.pos_default_currency").value("MXN"))
                .andExpect(jsonPath("$.pos_require_blind_closeout").value(true))
                .andExpect(jsonPath("$.pos_enable_cfdi_invoicing").value(false));

        variant = variantRepository.save(variant);

        Location wh = loc(tenantId, null, "WAREHOUSE", "WH-P", "/WH-P");
        Location zone = loc(tenantId, wh.getId(), "ZONE", "Z1", "/WH-P/Z1");

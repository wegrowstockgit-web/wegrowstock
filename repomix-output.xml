function statusChip(status?: string) {
  const normalized = status ?? 'UNKNOWN';
  return (
    <span
      className={cn(
        'rounded-full px-2 py-0.5 text-xs font-medium',
        SYNC_STATUS_STYLES[normalized] ?? 'bg-surface-overlay text-text-muted'
      )}
    >
      {normalized}
    </span>

}

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    @apply bg-surface text-text min-h-screen;
    margin: 0;
  }

  #root {
    @apply min-h-screen;
  }

  input,
  button,
  textarea,
  select {
    font: inherit;
  }

  :focus-visible {
    @apply outline-2 outline-offset-2 outline-accent;
  }
}

@layer components {
  .admin-field {
    @apply h-10 w-full rounded-md border border-border bg-surface px-3 text-sm text-text;
    @apply placeholder:text-text-muted focus:border-accent focus:outline-none;
  }

  .admin-field:focus {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-accent) 20%, transparent);
  }

  .admin-card {
    @apply rounded-lg border border-border bg-surface-raised shadow-card;
  }

  .admin-switch {
    appearance: none;
    width: 2.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--color-surface-overlay);
    position: relative;
    cursor: pointer;
    transition: background-color 160ms var(--ease-out);
  }

  .admin-switch::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background: var(--color-text);
    transition: transform 160ms var(--ease-out);
  }

  .admin-switch:checked {
    background: var(--color-accent);
  }

  .admin-switch:checked::after {
    transform: translateX(1rem);
  }

  .admin-switch:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .admin-switch:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  button:not(:disabled):active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .admin-switch,
    .admin-switch::after,
    button:not(:disabled):active {
      transition: none;
      transform: none;
    }
  }
}

<file path="frontends/apps/frontend_pos/src/styles/index.css">
@import '@fontsource/inter/latin-400.css';
@import '@fontsource/inter/latin-600.css';
@import '@fontsource/inter/latin-700.css';
@import '@fontsource/inter/latin-800.css';

@tailwind base;
@tailwind components;
@tailwind utilities;

/*
  THESIS: Light cashier register aligned with admin indigo, not a dark forest console.
  OWN-WORLD: Slate paper #f8fafc, white raised, ink #0f172a, accent #6366f1, semantic cash/card/void.
  STORY: Scan or tap a photo tile; every purchased line stays on screen with a large image, qty, and void.
  FIRST VIEWPORT: Header + scan + photo speed tiles + photo cart left; light pay console right.
  FORM: Square/Toast retail cart + speed menu, admin tokens inverted for store lighting.
*/

:root {
  --pos-surface: #f8fafc;
  --pos-raised: #ffffff;
  --pos-ink: #0f172a;
  --pos-muted: #475569;
  --pos-border: #e2e8f0;
  --pos-accent: #6366f1;
  --pos-accent-hover: #4f46e5;
  --pos-accent-soft: #eef2ff;
  --pos-success: #16a34a;
  --pos-success-soft: #dcfce7;
  --pos-warning: #d97706;
  --pos-danger: #dc2626;
  --pos-danger-soft: #fee2e2;
  --pos-cash: #f59e0b;
}

@layer base {
  html,
  body,
  #root {
    height: 100%;
    margin: 0;
  }

  body {
    font-family: Inter, ui-sans-serif, system-ui, sans-serif;
    background: var(--pos-surface);
    color: var(--pos-ink);
    -webkit-font-smoothing: antialiased;
  }

  button,
  input {
    font: inherit;
  }

  button:focus-visible,
  input:focus-visible,
  select:focus-visible,
  a:focus-visible {
    outline: 3px solid var(--pos-accent);
    outline-offset: 2px;
  }
}

@layer components {
  .pos-shell {
    display: flex;
    height: 100dvh;
    flex-direction: column;
    overflow: hidden;
    background: var(--pos-surface);
    color: var(--pos-ink);
    padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom)
      env(safe-area-inset-left);
  }

  .pos-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    background: var(--pos-raised);
    border-bottom: 1px solid var(--pos-border);
    color: var(--pos-ink);
    padding: 0.7rem 1rem;
  }

  .pos-brand {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .pos-meta {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--pos-muted);
  }

  .pos-count {
    margin: 0;
    font-variant-numeric: tabular-nums;
    font-size: 0.92rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .pos-chip {
    border-radius: 999px;
    padding: 0.4rem 0.75rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .pos-chip.is-live {
    background: var(--pos-success-soft);
    color: #166534;
  }

  .pos-chip.is-offline {
    background: #fef3c7;
    color: #92400e;
  }

  .pos-signin {
    min-height: 44px;
    border-radius: 0.5rem;
    background: var(--pos-accent);
    padding: 0 0.9rem;
    font-size: 0.85rem;
    font-weight: 800;
    color: #fff;
  }

  .pos-signin:active {
    transform: scale(0.97);
  }

  .pos-body {
    display: flex;
    min-height: 0;
    flex: 1;
    flex-direction: column;
  }

  .pos-cart {
    display: flex;
    min-height: 0;
    flex: 1 1 42%;
    flex-direction: column;
    background: var(--pos-surface);
  }

  .pos-cart-tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 0.85rem 0;
  }

  .pos-add-customer,
  .pos-clear-customer {
    min-height: 44px;
    border-radius: 0.5rem;

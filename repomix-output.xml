      contextLocked: false,
      lockReason: null,
    });
    useNetworkSyncStore.setState({ online: true, syncing: false, pendingCount: 0 });

    for (let i = 0; i < 7; i++) {
      useUiActionTrackerStore.getState().trackAction({

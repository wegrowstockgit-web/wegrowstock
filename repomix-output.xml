                                  "isGs1":true,
                                  "lotNumber":"A1",
                                  "expiryDate":"2026-01-15"
                                }
                                """.formatted(wh.getId(), allocationId)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.message").value(org.hamcrest.Matchers.containsString("3")));
    }

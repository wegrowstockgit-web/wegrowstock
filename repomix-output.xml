        # Apply color if specified
        svg_code = apply_color(svg_code, color)

        # Apply size
        svg_code = apply_viewbox_size(svg_code, size)

        # Determine output path
        if output_path is None:
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

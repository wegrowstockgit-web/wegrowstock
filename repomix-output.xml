<file path="frontends/apps/frontend_wms/src/styles/index.css">
@import '@fontsource/inter/latin-400.css';
@import '@fontsource/inter/latin-500.css';
@import '@fontsource/inter/latin-600.css';
@import '@fontsource/inter/latin-700.css';
@import './tokens.css';

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    /* Firefox & modern spec — stay in @layer base so .scrollbar-none / .scrollbar-thin win. */
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  /* Chrome, Edge, Safari */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background-color: var(--color-border);
    border-radius: 9999px;
    border: 2px solid transparent;
    background-clip: content-box;
  }

  ::-webkit-scrollbar-thumb:hover {
    background-color: var(--color-text-muted);
  }

  body {
    @apply bg-surface text-text min-h-screen;
    margin: 0;
  }

  #root {
    @apply min-h-screen;
  }

  input,
  button,
  textarea,
  select {
    font: inherit;
  }

  :focus-visible {
    @apply outline-2 outline-offset-2 outline-accent;
  }
}

@layer utilities {
  .tabular-nums {
    font-variant-numeric: tabular-nums;
  }

  .containment-layout {
    contain: layout;
  }

  /**
   * Virtualized body rows: layout containment only.
   * Do NOT set transform/will-change:transform on <tr> — that creates a
   * containing block and breaks position:sticky on frozen <td> cells
   * (headers stick, body columns shear/overlap on horizontal scroll).
   */
  .virtual-row-layer {
    contain: layout style;
  }

  /** Icon-rail nav: hide native scrollbar chrome (Track 1). */
  .scrollbar-none {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }

  /** Thin native scroll track for data grids (horizontal overflow). */
  .scrollbar-thin {
    scrollbar-width: thin;
  }

  .scrollbar-thin::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  .scrollbar-thin::-webkit-scrollbar-thumb {
    background-color: color-mix(in oklab, var(--color-border) 80%, transparent);
    border-radius: 999px;
  }

  .scrollbar-thin::-webkit-scrollbar-track {
    background: transparent;
  }

  /** Scroll-fade mask when nav content overflows the fold. */
  .rail-scroll-mask {
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 4%,
      black 92%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      black 4%,
      black 92%,
      transparent 100%
    );
  }
}

/* Density matrix — driven by html[data-density] (Surface A) */
:root,
[data-density='cozy'] {
  --density-cell-py: 0.5rem;
  --density-cell-px: 1rem;
  --density-text: 0.875rem;
  --density-row-h: 2.75rem;
}

[data-density='compact'] {
  --density-cell-py: 0.25rem;
  --density-cell-px: 0.5rem;
  --density-text: 0.75rem;
  --density-row-h: 2rem;
}

[data-density='spacious'] {
  --density-cell-py: 1rem;
  --density-cell-px: 1.5rem;
  --density-text: 1rem;
  --density-row-h: 4rem;
}

@layer components {
  .density-table {
    font-size: var(--density-text);
  }

  .table-head-accent {
    background-color: var(--color-table-header);
    color: var(--color-table-header-fg);
  }

  /* Header <tr>/<th> must stay opaque blue — body TableRow styles must not wash out white labels. */
  thead.table-head-accent > tr,
  thead.table-head-accent th,
  th.table-head-cell {
    background-color: var(--color-table-header) !important;
    color: var(--color-table-header-fg) !important;
  }

  /* Sticky column headers: opaque fill + edge so rows pass underneath cleanly. */
  /* Pinned header cells must paint above scrolling header labels. */
  th.table-head-cell[data-pinned='true'] {
    z-index: 60;
  }

  th.table-head-cell.sticky {
    box-shadow: 0 1px 0 0 #155a9c;
  }

  thead.table-head-accent > tr:hover,
  thead.table-head-accent > tr.table-row-interactive:hover {
    background-color: var(--color-table-header) !important;
  }

  .table-row-interactive {
    transition: background-color 100ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  tbody .table-row-interactive:hover {
    background-color: color-mix(in srgb, #1d70cb 5%, transparent);
  }

  tbody .table-row-interactive:active {
    background-color: color-mix(in srgb, #1d70cb 15%, transparent);
  }

  tbody .table-row-interactive[data-state='selected'],
  tbody .table-row-interactive[aria-selected='true'] {
    background-color: color-mix(in srgb, #1d70cb 10%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .table-row-interactive {
      transition: none;
    }
  }
}

/*
 * Warehouse floor: 48px (min-h-12) hit targets for glove-friendly scanning UIs.
 * Office desktop must NOT inherit scanner target inflation.
 */
[data-theme='warehouse'] button,
[data-theme='warehouse'] a[role='button'],
[data-theme='warehouse'] .touch-target {
  min-height: 3rem; /* 48px — Tailwind min-h-12 */
  min-width: 3rem;
}

[data-theme='warehouse'] .density-row {
  min-height: 3rem;
}

[data-theme='warehouse'] [data-density='compact'] {
  --density-cell-py: 0.5rem;
  --density-row-h: 3rem;
}

@media (pointer: coarse), (max-width: 1024px) {
  .touch-target {
    min-height: 3rem;
    min-width: 3rem;
  }

  /* Peek / admin sheets become full-width tap drawers on iPad footprints */
  [data-testid='right-peek-drawer'],
  [data-testid='slide-out-drawer'] {
    width: min(100vw, 28rem) !important;
    max-width: 100vw !important;
  }
}

/* Office admin: touch targets only on true phone widths */
@media (max-width: 767px) {
  [data-theme='office'] button,
  [data-theme='office'] a[role='button'],
  [data-theme='office'] .touch-target {
    min-height: 2.75rem;
    min-width: 2.75rem;
  }

  [data-theme='office'] .density-row {
    min-height: 2.75rem;
  }
}

/* Settings shell — widescreen office split-pane (static nav + content scrollport) */
[data-theme='office'] .settings-shell {
  width: 100%;
  max-width: 80rem; /* max-w-7xl */
  margin-inline: auto;
  height: 100%;
}

[data-theme='office'] .settings-shell__nav {
  min-width: 0;
}

@media (min-width: 1024px) {
  [data-theme='office'] .settings-shell__nav {
    /* Rail-style: column fills the pane and scrolls its own links (like the app Sidebar). */
    align-self: stretch;
    scrollbar-width: thin;
  }
}

@media (max-width: 1023px) {
  [data-theme='office'] {
    --rail-width-collapsed: 0px;
    --rail-width: 0px;
  }
}

/* Surface B scanner validation motion */
@keyframes scan-success-enter {
  from {
    opacity: 0;
    transform: scale(0.98);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes scan-error-shake {
  0%,
  100% {
    transform: translateX(0);
  }
  20% {
    transform: translateX(-6px);
  }
  40% {
    transform: translateX(6px);
  }
  60% {
    transform: translateX(-4px);
  }
  80% {
    transform: translateX(4px);
  }
}

.scan-success-enter {
  animation: scan-success-enter 220ms cubic-bezier(0.23, 1, 0.32, 1) both;
}

.scan-error-shake {
  animation: scan-error-shake 280ms cubic-bezier(0.22, 1, 0.36, 1) both;
}

@keyframes page-help-fade {
  from {
    opacity: 0;
    transform: translateY(4px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.page-help-fade {
  animation: page-help-fade 180ms ease-out both;
}

@keyframes support-spotlight-pulse {
  0%,
  100% {
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-accent) 55%, transparent);
  }
  50% {
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--color-accent) 35%, transparent);
  }
}

.support-spotlight-ring {
  outline: 2px solid var(--color-accent);
  outline-offset: 3px;
  border-radius: 0.375rem;
  animation: support-spotlight-pulse 0.75s ease-in-out 4;
  z-index: 5;
  position: relative;
}

@media (prefers-reduced-motion: reduce) {
  .scan-success-enter,
  .scan-error-shake,
  .page-help-fade,
  .support-spotlight-ring {
    animation: none;
  }

  .scan-success-enter {
    opacity: 1;
  }

  .page-help-fade {
    opacity: 1;
    transform: none;
  }
}

@media print {
  [data-print-hide],
  [data-testid='icon-rail'] {
    display: none !important;
  }

  [data-testid='app-shell'] {
    display: block !important;
    height: auto !important;
    overflow: visible !important;
  }

  [data-testid='app-shell'] > div {
    padding-left: 0 !important;
  }

  [data-testid='app-shell-main'] {
    overflow: visible !important;
    height: auto !important;
  }
}

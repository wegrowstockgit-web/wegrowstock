    fireEvent.click(screen.getByText('search'));
    await waitFor(() =>
      expect(apiClient.get).toHaveBeenCalledWith(
        '/api/v1/purchase-orders',
        expect.objectContaining({ params: expect.objectContaining({ search: 'Acme' }) }),
      ),

    await waitFor(() => expect(screen.getByTestId('count')).toHaveTextContent('1'));
    expect(screen.getByTestId('total')).toHaveTextContent('3');
    expect(apiClient.get).toHaveBeenCalledWith(
      '/api/v1/purchase-orders',

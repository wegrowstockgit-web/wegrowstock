        params: expect.objectContaining({ page: 1, size: 50, sort: 'createdAt,desc', status: 'OPEN' }),
      }),
    );
    fireEvent.click(screen.getByText('next'));
    await waitFor(() =>
      expect(apiClient.get).toHaveBeenCalledWith(
        '/api/v1/purchase-orders',

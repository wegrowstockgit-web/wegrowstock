  beforeEach(() => {
    registerAppModules([
      defineModule({
        id: 'products',
        enabled: true,
        officeRoutes: [{ path: 'products', element: null }],
        navItems: [{ to: '/products', label: 'Products', moduleId: 'products' }],
      }),
      defineModule({
        id: 'fintech',
        enabled: false,
        officeRoutes: [{ path: 'settings/fintech', element: null }],

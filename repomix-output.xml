  ALLOWED_EXTS,
  EDIT_COUNT_THRESHOLD,
  GENERATED_PATH,
  SENSITIVE_PATH,
  appendDesignSystemNote,
  designSystemOptions,
  filterFindings,
  isNativePlatform,
  loadDetector,
  matchConfiguredExtension,
  matchesAnyGlob,
  persistCache,
  readCache,

        timeout: 20_000,
      });
      expect(await overflowY(owner.page.getByTestId('app-shell-main'))).toMatch(/auto|scroll/);

      await owner.page.goto('/purchase-orders');
      await expect(owner.page.getByRole('heading', { name: 'Purchase Orders' })).toBeVisible({

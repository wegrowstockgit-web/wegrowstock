                        .header("Authorization", "Bearer " + token))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.length()").value(greaterThanOrEqualTo(1)))
                .andReturn()
                .getResponse()
                .getContentAsString());
        String wholesaleId = null;

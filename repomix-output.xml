    expect(result.current.lastHttpErrorStatus).toBe(409);
    expect(result.current.lastHttpErrorMessage).toMatch(/BIN_LOCKED/i);
    expect(result.current.trace_id).toBe('4bf92f3577b34da6a3ce929d0e0e4736');

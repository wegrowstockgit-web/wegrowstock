import {
  BORDER_SAFE_TAGS,
  EM_DASH_CHARS_PER_DASH,
  EM_DASH_FLOOR,
  GENERIC_FONTS,
  KNOWN_SERIF_FONTS,
  OVERUSED_FONTS,
  SAFE_TAGS,
  WCAG_LARGE_BOLD_TEXT_PX,
  WCAG_LARGE_TEXT_PX,
  isBrandFontOnOwnDomain,

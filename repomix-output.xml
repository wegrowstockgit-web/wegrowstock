                .toList();
        return portalService.requestQuote(
                lines,
                request.customerPoNumber(),
                request.requestedShipDate(),
                parsePolicy(request.allocationPolicy()),
                request.quoteNotes());
    }

    @PostMapping("/orders/{orderId}/accept-quote")

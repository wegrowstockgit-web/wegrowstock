      if (toastEl !== currentToast) return;
      currentToast.style.opacity = '1';
      currentToast.style.transform = 'translateX(-50%) translateY(0)';
    });
    setTimeout(() => {
      if (toastEl !== currentToast) return;
      currentToast.style.opacity = '0';
      currentToast.style.transform = 'translateX(-50%) translateY(8px)';
      setTimeout(() => {
        if (toastEl !== currentToast) return;
        currentToast.remove();
        toastEl = null;
      }, 250);
    }, duration);

                .isEqualTo("PATCH");
        assertThat(new ActionDraft("t", "d", "/api/v1/x", "  PUT  ", Map.of()).httpMethod())
                .isEqualTo("PUT");
        assertThat(new ActionDraft("t", "d", "/api/v1/x", "", Map.of()).httpMethod())
                .isEqualTo("POST");
        assertThat(new ActionDraft("t", "d", "/api/v1/x", "TRACE", Map.of()).httpMethod())

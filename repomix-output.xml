      expect(draftExecuteCalls).toBe(0);

      await manager.page.getByTestId('training-mission-exit').click();
      await expect(manager.page.getByTestId('training-mission-banner')).toHaveCount(0);
    } finally {
      await manager.close();
    }
  });
});

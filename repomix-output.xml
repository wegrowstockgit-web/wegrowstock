    @Test
    void customerMasterKnowledgeCoversPriceTiersAndCreditHold() throws Exception {
        String slug = "pk-cu-" + UUID.randomUUID().toString().substring(0, 8);
        TokenResponse owner = authService.signup(new SignupRequest(

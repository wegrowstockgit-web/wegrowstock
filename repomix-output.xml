routeHints: ["/showroom/catalog", "/showroom/orders", "/showroom/checkout", "/showroom/billing", "/customers", "/invoices", "/mesh-network", "/settings", "/settings?tab=retailPos", "/settings/billing", "/settings/fintech", "/settings/integrations"]

function objectKeyCandidatesForOp(batch, op) {
  const candidates = (batch.candidates || [])
    .filter((item) => item.entryId === op.entryId && item.ref === op.ref);
  return candidates.flatMap((candidate) => candidate.objectKeyMatches || []);

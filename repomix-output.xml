                .andExpect(jsonPath("$.lotNumber").value("VENDOR-LOT-FSMA-99"))
                .andExpect(jsonPath("$.sku").value("FSMA-1"))
                .andExpect(jsonPath("$.origin.quantity").value(8));
    }
}

          </div>
        ),
      },
      {
        id: 'sku',
        header: 'SKU',
        width: 128,
        maxWidth: 148,
        sortable: true,
        sortValue: (product) => product.sku,
        cell: (product) => (
          <span className="block truncate font-mono text-text" title={product.sku}>
            {product.sku}
          </span>
        ),
      },
      {
        id: 'name',
        header: 'Name',
        width: 200,
        maxWidth: 280,
        sortable: true,
        sortValue: (product) => product.name,
        cell: (product) => (
          <span className="block truncate text-text" title={product.name}>
            {product.name}
          </span>
        ),
      },
      {
        id: 'barcode',
        header: 'Barcode',
        width: 120,
        maxWidth: 160,
        flexGrow: true,
        sortable: true,
        sortValue: (product) => product.barcode ?? '',
        cell: (product) => (
          <span className="block truncate font-mono text-text-muted" title={product.barcode ?? undefined}>
            {product.barcode ?? '—'}
          </span>
        ),
      },
      {
        id: 'onHand',

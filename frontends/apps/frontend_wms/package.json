{
  "name": "frontend_wms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "chatbot:enable": "node scripts/resolve-modules.mjs --enable-chatbot",
    "chatbot:disable": "node scripts/resolve-modules.mjs --disable-chatbot",
    "training:enable": "node scripts/resolve-modules.mjs --enable-training",
    "training:disable": "node scripts/resolve-modules.mjs --disable-training",
    "predev": "node scripts/resolve-modules.mjs",
    "dev": "vite",
    "prebuild": "node scripts/resolve-modules.mjs",
    "build": "tsc -b && vite build && vite build --config vite.sw.config.ts",
    "build:no-chatbot": "node scripts/resolve-modules.mjs --disable-chatbot && tsc -b && vite build && vite build --config vite.sw.config.ts",
    "build:no-training": "node scripts/resolve-modules.mjs --disable-training && tsc -b && vite build && vite build --config vite.sw.config.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "pretest": "node scripts/resolve-modules.mjs",
    "test:e2e": "playwright test",
    "test:e2e:personas": "playwright test --project=Desktop-Admin --project=Mobile-Scanner --project=Tablet-Manager",
    "test:e2e:ui": "playwright test --ui",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:support": "vitest run --coverage src/modules/chatbot --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0",
    "test:e2e:support": "playwright test --project=chromium e2e/journeys/43-support-copilot-action-chips.spec.ts e2e/journeys/44-support-copilot-agentic-tools.spec.ts e2e/journeys/45-support-awareness-drafts-training.spec.ts e2e/journeys/50-support-proactive-action-drafts.spec.ts e2e/journeys/51-support-camera-training-simulator.spec.ts e2e/support-assistant-personas.spec.ts e2e/support-multipage-tour.spec.ts",
    "test:e2e:gs1": "playwright test e2e/gs1-composite-scan.spec.ts",
    "audit:fix": "npm audit --omit=dev",
    "clean": "node -e \"const fs=require('fs');['dist','node_modules','.vite','tsconfig.tsbuildinfo','tsconfig.app.tsbuildinfo','tsconfig.node.tsbuildinfo'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}})\""
  },
  "dependencies": {
    "@capacitor/core": "^7.4.3",
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@tanstack/query-async-storage-persister": "^5.90.2",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-persist-client": "^5.90.2",
    "@tanstack/react-virtual": "^3.13.12",
    "@zxing/library": "^0.23.0",
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
    "driver.js": "^1.8.0",
    "i18next": "^25.3.2",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.525.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^15.6.1",
    "react-router-dom": "^7.7.0",
    "recharts": "^3.9.2",
    "tailwind-merge": "^2.6.0",
    "workbox-core": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@playwright/test": "^1.54.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.15",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/serviceworker": "^0.0.200",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "terser": "^5.50.0",
    "typescript": "~7.0.2",
    "vite": "^7.0.5",
    "vitest": "^3.2.4"
  }
}

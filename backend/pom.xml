<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.invsys</groupId>
    <artifactId>invsys-api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>InventorySystem API</name>

    <properties>
        <java.version>25</java.version>
        <jacoco.minimum.coverage>0.85</jacoco.minimum.coverage>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-micrometer-metrics</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.loki4j</groupId>
            <artifactId>loki-logback-appender</artifactId>
            <version>1.6.0</version>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.1</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jooq</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.0.3</version>
        </dependency>
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>10.4.2</version>
        </dependency>
        <!-- S3-compatible object storage (AWS, GCP HMAC, Azure S3 gateway, DO Spaces, MinIO) -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>2.31.78</version>
        </dependency>
        <dependency>
            <groupId>com.stripe</groupId>
            <artifactId>stripe-java</artifactId>
            <version>28.4.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <configuration>
                    <url>jdbc:postgresql://localhost:5432/invsys</url>
                    <user>app_owner</user>
                    <password>app_owner_secret</password>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimum.coverage}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                            <excludes>
                                <exclude>com/invsys/InvSysApplication.class</exclude>
                                <exclude>com/invsys/config/**</exclude>
                                <exclude>com/invsys/media/**</exclude>
                                <exclude>com/invsys/domain/**</exclude>
                                <exclude>com/invsys/repository/**</exclude>
                                <exclude>com/invsys/common/**</exclude>
                                <exclude>com/invsys/auth/**</exclude>
                                <exclude>com/invsys/api/**</exclude>
                                <exclude>com/invsys/integration/**</exclude>
                                <exclude>com/invsys/billing/**</exclude>
                                <exclude>com/invsys/tenancy/BootstrapJdbc.class</exclude>
                                <exclude>com/invsys/service/ReportingAnalyticsService.class</exclude>
                                <exclude>com/invsys/service/PortalService*.class</exclude>
                                <exclude>com/invsys/service/ReturnService*.class</exclude>
                                <exclude>com/invsys/service/UserManagementService.class</exclude>
                                <exclude>com/invsys/service/InvoicingService.class</exclude>
                                <exclude>com/invsys/service/FxSyncWorker.class</exclude>
                                <exclude>com/invsys/service/ForecastingWorker.class</exclude>
                                <exclude>com/invsys/service/WebhookInboxWriter*.class</exclude>
                                <exclude>com/invsys/service/WebhookEventProcessor.class</exclude>
                                <exclude>com/invsys/service/VariantCatalogService.class</exclude>
                                <exclude>com/invsys/service/AccountMappingService*.class</exclude>
                                <exclude>com/invsys/service/BillingService*.class</exclude>
                                <exclude>com/invsys/service/ChannelIntegrationService.class</exclude>
                                <exclude>com/invsys/service/CurrencyService.class</exclude>
                                <exclude>com/invsys/service/SsoConfigService*.class</exclude>
                                <exclude>com/invsys/service/TenantDomainService.class</exclude>
                                <exclude>com/invsys/service/ShippingCredentialService*.class</exclude>
                                <exclude>com/invsys/service/ReconciliationService*.class</exclude>
                                <exclude>com/invsys/service/SerialScanQueryService.class</exclude>
                                <exclude>com/invsys/service/SettingsService.class</exclude>
                                <exclude>com/invsys/service/IdempotencyService*.class</exclude>
                                <exclude>com/invsys/service/ForecastingService*.class</exclude>
                                <exclude>com/invsys/service/WebhookService.class</exclude>
                                <exclude>com/invsys/service/AccountingPaymentWebhookService*.class</exclude>
                                <exclude>com/invsys/service/TaxService.class</exclude>
                                <exclude>com/invsys/service/CreditService.class</exclude>
                                <exclude>com/invsys/service/SerialNumberService.class</exclude>
                                <exclude>com/invsys/service/SupplierPortalService*.class</exclude>
                                <exclude>com/invsys/service/CycleCountService*.class</exclude>
                                <exclude>com/invsys/service/EdiTranslationEngine.class</exclude>
                                <exclude>com/invsys/service/ApOcrIngestionService*.class</exclude>
                                <exclude>com/invsys/service/PlatformAlertService*.class</exclude>
                                <exclude>com/invsys/dns/**</exclude>
                                <exclude>com/invsys/gateway/**</exclude>
                                <exclude>com/invsys/service/PathOptimizationScheduler*.class</exclude>
                                <exclude>com/invsys/service/OperationsConsoleService*.class</exclude>
                                <exclude>com/invsys/service/OverdueInvoiceScheduler*.class</exclude>
                                <exclude>com/invsys/service/LocalMlInferenceClient*.class</exclude>
                                <exclude>com/invsys/service/CapitalUnderwritingScheduler*.class</exclude>
                                <exclude>com/invsys/service/ForecastingInferenceService*.class</exclude>
                                <exclude>com/invsys/service/ScanService*.class</exclude>
                                <exclude>com/invsys/service/ShipmentService*.class</exclude>
                                <exclude>com/invsys/service/InventoryGenealogyService*.class</exclude>
                                <exclude>com/invsys/service/FieldFulfillmentService*.class</exclude>
                                <exclude>com/invsys/service/InternalConsumptionService*.class</exclude>
                                <exclude>com/invsys/service/WarehouseContextService*.class</exclude>
                                <exclude>com/invsys/service/TerminalBiometricService*.class</exclude>
                                <exclude>com/invsys/service/FulfillmentExceptionService*.class</exclude>
                                <exclude>com/invsys/service/CrossDockService*.class</exclude>
                                <exclude>com/invsys/service/IntegrationVaultSettingsService*.class</exclude>
                                <exclude>com/invsys/service/OfflineSyncConflictService*.class</exclude>
                                <exclude>com/invsys/billing/MockCapitalGateway.class</exclude>
                                <exclude>com/invsys/billing/CapitalGateway*.class</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>

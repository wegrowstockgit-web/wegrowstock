# syntax=docker/dockerfile:1

FROM maven:3.9-eclipse-temurin-25-alpine AS build
WORKDIR /app
COPY pom.xml .
COPY invsys-core/pom.xml invsys-core/pom.xml
COPY invsys-chatbot/pom.xml invsys-chatbot/pom.xml
COPY invsys-training/pom.xml invsys-training/pom.xml
COPY invsys-app/pom.xml invsys-app/pom.xml
COPY invsys-admin-api/pom.xml invsys-admin-api/pom.xml
# Parent POM lists all modules; stub POMs satisfy the reactor without copying WMS sources.
RUN mvn -q dependency:go-offline -pl invsys-admin-api -am || true
COPY invsys-core invsys-core
COPY invsys-admin-api invsys-admin-api
RUN mvn -q -Dmaven.test.skip=true package -pl invsys-admin-api -am

FROM eclipse-temurin:25-jre-alpine
RUN addgroup -S invsys && adduser -S invsys -G invsys
WORKDIR /app
COPY --from=build /app/invsys-admin-api/target/*.jar app.jar
USER invsys
EXPOSE 8081
HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
  CMD wget -qO- http://localhost:8081/actuator/health || exit 1
ENTRYPOINT ["java", "-jar", "app.jar"]

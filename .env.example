# Database (local docker-compose defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=invsys
DB_USER=app_user
DB_PASSWORD=app_user_secret
FLYWAY_USER=app_owner
FLYWAY_PASSWORD=app_owner_secret

# JWT RS256 keys (generate with: openssl genrsa 2048 / openssl rsa -pubout)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Stripe mock webhook
STRIPE_WEBHOOK_SECRET=whsec_mock_secret
SHOPIFY_WEBHOOK_SECRET=shopify_mock_secret
EASYPOST_WEBHOOK_SECRET=easypost_mock_secret
PUBLIC_SIGNUP_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Also allow https://{domain} for DNS-ACTIVE tenant domains (API gateway dynamic whitelist)
CORS_INCLUDE_VERIFIED_DOMAINS=true
FRONTEND_URL=http://localhost:3000
# Production: set SPRING_PROFILES_ACTIVE=prod and replace all mock secrets / JWT keys.

# Integration credential encryption (32 bytes, base64-encoded; generate with: openssl rand -base64 32)
INTEGRATION_MASTER_KEY=

# Support Co-Pilot / RAG (Google GenAI). Defaults: gemini-2.5-flash + text-embedding-004.
# GEMINI_API_KEY=
# SPRING_AI_GOOGLE_GENAI_CHAT_OPTIONS_MODEL=gemini-2.5-flash
# SUPPORT_AI_LLM=gemini
